# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/ (http context).
# Only variables present in the container environment are substituted, so $uri, $host etc. stay intact.

server_tokens off;
client_max_body_size 2m;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# Per-IP request limits (the API applies its own, finer limits too).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=keys:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

# Plain HTTP: ACME challenges for certbot, everything else redirects to HTTPS.
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# Unknown host names over HTTPS: refuse the handshake.
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  ssl_reject_handshake on;
}

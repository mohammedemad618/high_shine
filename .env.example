# Copy to infra/.env on the server (docker compose reads it from there) and fill every value.
# Generate secrets with: openssl rand -base64 48

# ---- Domains ----
API_DOMAIN=api.example.com
MEDIA_DOMAIN=media.example.com
WEB_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
LETSENCRYPT_EMAIL=you@example.com

# Public URLs the API writes into playlists and responses
PUBLIC_API_URL=https://api.example.com
MEDIA_PUBLIC_URL=https://media.example.com
# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=https://example.com,https://admin.example.com

# ---- MongoDB ----
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_DB=lectures
MONGO_APP_USER=lectures_app
MONGO_APP_PASSWORD=change-me-app
# Shared secret between replica-set members (MongoDB requires it once auth is on). Any long random string.
MONGO_REPLICA_KEY=change-me-replica-key
# Used by api and worker. Inside compose the host is "mongo".
MONGO_URI=mongodb://lectures_app:change-me-app@mongo:27017/lectures?replicaSet=rs0&authSource=lectures

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Secrets ----
JWT_SECRET=change-me-jwt
PLAYBACK_SECRET=change-me-playback
# Nginx reads the same value (see infra/nginx/templates/media.conf.template)
SECURE_LINK_SECRET=change-me-secure-link

# ---- Auth ----
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
DEFAULT_MAX_DEVICES=2

# ---- Media ----
# Host folder shared by api, worker and nginx
MEDIA_HOST_DIR=/srv/media
# Playback token lifetime (seconds). Signed segment links expire with it.
PLAYBACK_TTL_SEC=14400
# Keep the original upload after a successful transcode (true/false)
KEEP_SOURCE=true
# Max upload size in bytes (default 8 GB)
MAX_UPLOAD_BYTES=8589934592
# One transcode job per 4 cores
TRANSCODE_CONCURRENCY=1

# ---- Front ends (baked in at build time) ----
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com
VITE_API_URL=https://api.example.com/api/v1

# ---- Backups ----
# rclone remote configured on the host with `rclone config`, e.g. backup:lectures
RCLONE_REMOTE=backup:lectures
BACKUP_KEEP_DAYS=14
